# ==============================
# LandIQ - Git Ignore
# ==============================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual Environment
.venv/
venv/
env/

# Environment / Secrets
.env
.env.*
!.env.example

# Backend uploads / generated files
backend/uploads/*
!backend/uploads/.gitkeep

# Database / local data
*.db
*.sqlite
*.sqlite3

# Logs
*.log
logs/

# Node / React Native / Expo
node_modules/
.expo/
.expo-shared/
dist/
web-build/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# React Native
.metro-health-check*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# IDE
.idea/

# Temporary files
*.tmp
*.temp
*.swp
*.swo

# Build / generated files
build/
coverage/

# ==============================
# End of LandIQ Git Ignore
# ==============================

LandIQ_fixed.zip
